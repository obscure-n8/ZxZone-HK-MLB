# ============================================
# ZxZone-HK-MLB Bot Configuration
# Heroku Optimized
# ============================================

# Telegram API (Required)
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_USERNAME=YourBotUsername

# Owner & Admins
OWNER_ID=your_telegram_id
SUDO_USERS=

# Channels & Links
UPDATE_CHANNEL=https://t.me/zxzoneupdates
REPO_LINK=https://github.com/obscure-n8/ZxZone-HK-MLB

# Database (Required)
DATABASE_URL=mongodb://localhost:27017/zxzone_hk_mlb
REDIS_URL=redis://localhost:6379

# Aria2 Configuration
ARIA2_HOST=http://localhost
ARIA2_PORT=6800
ARIA2_SECRET=

# Rclone Configuration
RCLONE_REMOTE=gdrive
RCLONE_CONFIG_PATH=config/rclone.conf

# Bot Settings
MAX_TASKS_PER_USER=3
MAX_TOTAL_TASKS=25
QUEUE_LIMIT=10
DEFAULT_UPLOAD_MODE=document
ALLOW_PRIVATE_FILES=True
FORCE_SUBSCRIBE=True

# Heroku Settings
PORT=8080
APP_URL=https://your-app.herokuapp.com

# Task Limits (0 = Unlimited, Heroku optimized)
DIRECT_LIMIT=3
MEGA_LIMIT=2
TORRENT_LIMIT=2
LEECH_LIMIT=5
YTDLP_LIMIT=3
PLAYLIST_LIMIT=2

# Disable Options (True/False)
DISABLE_TORRENTS=False
DISABLE_LEECH=False
DISABLE_MIRROR=False
DISABLE_BULK=False
DISABLE_MULTI=False
DISABLE_SEED=False
DISABLE_FF_MODE=False
DISABLE_JD=False
DISABLE_NZB=False
DISABLE_RSS=False
DISABLE_SEARCH=False
DISABLE_STREAM=True
DISABLE_YTDLP=False
DISABLE_MEGA=False

# Mega API
MEGA_EMAIL=
MEGA_PASSWORD=

# Queue System (Heroku optimized)
QUEUE_ALL=25
QUEUE_DOWNLOAD=10
QUEUE_UPLOAD=5

# JDownloader
JD_EMAIL=
JD_PASS=

# Bot Settings
BOT_PM=False
SET_COMMANDS=True
TIMEZONE=Asia/Dhaka
FORCE_SUB_IDS=
MEDIA_STORE=True
DELETE_LINKS=False
VERIFY_TIMEOUT=0
LOGIN_PASS=

# Log Channels
LEECH_DUMP_CHAT=
LINKS_LOG_ID=
MIRROR_LOG_ID=
